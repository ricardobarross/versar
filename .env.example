# Copie para .env.local e preencha. Na Vercel, configure em Settings → Environment Variables.

# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secreta — só no servidor. Usada pelo checkout e pelos webhooks.
SUPABASE_SERVICE_ROLE_KEY=

# Endereço público da loja (SEO / links de partilha)
NEXT_PUBLIC_SITE_URL=https://versar-ochre.vercel.app

# Secretária Inteligente (opcional). Sem chave, usa textos automáticos.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# Webhooks (/api/webhooks). Sem segredo, a rota fica desligada.
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=
